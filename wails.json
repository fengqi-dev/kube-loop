{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "kube-loop",
  "outputfilename": "KubeLoop",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev:wails",
  "frontend:dev:serverUrl": "auto",
  "viteServerTimeout": 180,
  "preBuildHooks": {
    "*/*": "go run ../../build/helper-prebuild.go ${platform}"
  },
  "postBuildHooks": {
    "*/*": "go run ../../build/stage-package-assets.go ${platform}"
  },
  "author": {
    "name": "KubeLoop"
  },
  "info": {
    "companyName": "KubeLoop",
    "productName": "KubeLoop",
    "productVersion": "1.1.0",
    "copyright": "Copyright © KubeLoop",
    "comments": "Local development network for Kubernetes"
  },
  "nsisType": "multiple"
}
