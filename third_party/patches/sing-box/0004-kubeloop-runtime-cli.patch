@@ -0,0 +1,9 @@
+//go:build kubeloop_minimal
+
+package main
+
+func init() {
+	// KubeLoop invokes only run, check, and version. Keep Cobra's generated
+	// completion command out of the runtime-only binary too.
+	mainCommand.CompletionOptions.DisableDefaultCmd = true
+}
diff --git a/cmd/sing-box/cmd_kubeloop_minimal_test.go b/cmd/sing-box/cmd_kubeloop_minimal_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/sing-box/cmd_kubeloop_minimal_test.go
@@ -0,0 +1,29 @@
+//go:build kubeloop_minimal
+
+package main
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestKubeLoopMinimalCommands(t *testing.T) {
+	mainCommand.InitDefaultHelpCmd()
+	mainCommand.InitDefaultCompletionCmd()
+
+	commands := mainCommand.Commands()
+	got := make([]string, 0, len(commands))
+	for _, command := range commands {
+		if command.IsAvailableCommand() {
+			got = append(got, command.Name())
+		}
+	}
+	slices.Sort(got)
+	want := []string{"check", "run", "version"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("minimal commands = %v, want %v", got, want)
+	}
+	if !mainCommand.CompletionOptions.DisableDefaultCmd {
+		t.Fatal("default completion command is enabled")
+	}
+}
