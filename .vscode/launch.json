{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wails: Debug KubeLoop",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/bin/KubeLoop",
      "windows": {
        "program": "${workspaceFolder}/build/bin/KubeLoop.exe"
      },
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}",
      "env": {}
    },
    {
      "name": "Go: Test package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-count=1"]
    },
    {
      "name": "Go: Test file",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${file}",
      "args": ["-count=1"]
    },
    {
      "name": "third_party: Debug Sing-box",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "debugAdapter": "dlv-dap",
      "processId": "sing-box",
      "asRoot": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/third_party/sing-box",
      "stopOnEntry": false,
      "showLog": true
    }
  ]
}
