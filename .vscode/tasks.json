{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: install",
      "type": "npm",
      "script": "install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build: helper",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "./build/bundle-helper.sh",
      "args": ["dev"],
      "windows": {
        "options": {
          "shell": {
            "executable": "bash",
            "args": ["-lc"]
          }
        },
        "command": "./build/bundle-helper.sh dev"
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "build",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CGO_ENABLED": "1"
        }
      },
      "osx": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "CGO_ENABLED": "1",
            "CGO_LDFLAGS": "-framework UniformTypeIdentifiers"
          }
        }
      },
      "command": "go",
      "args": [
        "build",
        "-tags",
        "dev",
        "-gcflags",
        "all=-N -l",
        "-o",
        "build/bin/KubeLoop"
      ],
      "windows": {
        "args": [
          "build",
          "-tags",
          "dev",
          "-gcflags",
          "all=-N -l",
          "-o",
          "build/bin/KubeLoop.exe"
        ]
      },
      "dependsOn": [
        "npm: build",
        "build: helper",
        "sing-box: build debug binary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "sing-box: build debug binary",
      "type": "process",
      "command": "go",
      "args": [
        "run",
        "./build/singbox-debug.go"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$go"
      ],
      "presentation": {
        "clear": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "KubeLoop: wails dev with sing-box source",
      "type": "process",
      "command": "wails",
      "args": [
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "KUBELOOP_SINGBOX_SOURCE": "debug"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
