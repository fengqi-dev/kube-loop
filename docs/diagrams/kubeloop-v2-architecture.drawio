        <mxCell id="d_dial" value="受限 Cluster Dialer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;" vertex="1" parent="d_gateway"><mxGeometry x="525" y="90" width="190" height="70" as="geometry"/></mxCell>
