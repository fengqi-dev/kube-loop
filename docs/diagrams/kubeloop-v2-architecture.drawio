        <mxCell id="c_select" value="选择 ready / non-draining Relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="c_l4"><mxGeometry x="900" y="35" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c_ticket" value="签发绑定 Session / Relay / Scope 的 RelayTicket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="c_l2"><mxGeometry x="1110" y="35" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="c_wss" value="连接 /tunnel&lt;br&gt;Token + Ticket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="c_l1"><mxGeometry x="1340" y="35" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="c_verify" value="离线验签&lt;br&gt;aud / exp / jti / scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;" vertex="1" parent="c_l5"><mxGeometry x="1530" y="35" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="c_limits" value="返回 Stream Limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;" vertex="1" parent="c_l5"><mxGeometry x="1730" y="35" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="c_helper" value="安装 Route / Split DNS&lt;br&gt;启动 sing-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;" vertex="1" parent="c_l6"><mxGeometry x="1730" y="35" width="180" height="60" as="geometry"/></mxCell>
