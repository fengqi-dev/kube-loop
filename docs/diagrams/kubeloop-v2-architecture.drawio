  <diagram id="traffic" name="05 Traffic Task生命周期">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="e_title" value="Exchange / Mirror / Preview Task 生命周期" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="e_request" value="创建 Traffic Task&lt;br&gt;Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="e_auth" value="认证 + Namespace / Operation 授权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="e_validate" value="校验 Service、端口、本地目标和 Session 所有权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="e_kind" value="Task 类型？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="860" y="95" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="e_snapshot" value="Exchange / Mirror&lt;br&gt;快照现有资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="e_preview" value="Preview&lt;br&gt;确认名称未占用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="e_reserve" value="预留 Task / Reverse Listener&lt;br&gt;生成 owner identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1340" y="120" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="e_mutate" value="事务化修改或创建 Kubernetes 资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1620" y="120" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="e_bind" value="绑定 RelayTicket 范围内的 Reverse Stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1620" y="300" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="e_running" value="Task = running" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="310" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="e_trigger" value="停止 / 断线 / Token 撤销 / 过期 / 故障" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="1090" y="295" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="e_stop" value="停止新连接并排空活动 Stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="1"><mxGeometry x="820" y="305" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="e_restorekind" value="资源类型？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="e_restore" value="Exchange / Mirror&lt;br&gt;按 owner 和 resourceVersion 恢复快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="e_delete" value="Preview&lt;br&gt;只删除自身拥有的资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="e_release" value="注销 Reverse Listener&lt;br&gt;释放 Task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="e_stopped" value="Task = stopped" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="e_rollback" value="逆序回滚已完成步骤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="e_fail" value="Task = failed&lt;br&gt;稳定错误码" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="565" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="e_conflict" value="cleanup-required&lt;br&gt;拒绝覆盖第三方修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="560" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="ee1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_request" target="e_auth" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee2" value="allow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_auth" target="e_validate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_validate" target="e_kind" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee4" value="Exchange / Mirror" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_kind" target="e_snapshot" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee5" value="Preview" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_kind" target="e_preview" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_snapshot" target="e_reserve" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_preview" target="e_reserve" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_reserve" target="e_mutate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_mutate" target="e_bind" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_bind" target="e_running" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_running" target="e_trigger" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_trigger" target="e_stop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_stop" target="e_restorekind" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_restorekind" target="e_restore" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_restorekind" target="e_delete" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_restore" target="e_release" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="e_delete" target="e_release" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
