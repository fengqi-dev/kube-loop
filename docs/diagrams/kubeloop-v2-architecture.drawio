        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="c_wss" target="c_verify" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="c_verify" target="c_limits" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
