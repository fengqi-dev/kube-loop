        <mxCell id="c_connected" value="Connected" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;" vertex="1" parent="c_l2"><mxGeometry x="1940" y="35" width="160" height="60" as="geometry"/></mxCell>
